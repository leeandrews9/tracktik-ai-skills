# Copy to .env and fill in. Never commit .env.
TT_BASE_URL=https://yourcompany.staffr.net
TT_USERNAME=api-ai-readonly
TT_PASSWORD=
# Only if your tenant issued OAuth client credentials:
TT_CLIENT_ID=
TT_CLIENT_SECRET=
# Local time zone for date windows and reports
TT_TZ=America/Los_Angeles
# Optional overrides
# TT_REST_PREFIX=/rest/v1
# TT_TOKEN_URL=https://yourcompany.staffr.net/rest/oauth2/access_token

# Demo mode: uncomment to use the synthetic dataset instead of a tenant
# TT_FIXTURES=fixtures
